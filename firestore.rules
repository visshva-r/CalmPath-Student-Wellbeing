rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/checkins/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.severity in ['low', 'moderate', 'high']
        && request.resource.data.score is number;
      allow update: if false;
    }

    match /users/{userId}/plans/{docId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId;
      allow update: if false;
    }

    match /users/{userId}/followups/{docId} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /publicCheckins/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.severity in ['low', 'moderate', 'high']
        && request.resource.data.score is number
        && !('uid' in request.resource.data)
        && !('notes' in request.resource.data);
      allow update, delete: if false;
    }
  }
}
